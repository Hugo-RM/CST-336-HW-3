<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head.ejs") %>
    <title>What's Your PokeMon Birthday!</title>
</head>

<body>
    <nav>
        <%- include("partials/nav.ejs") %>
    </nav>

    <div class="container py-5 text-center">
        <h1 class="mb-4">What's Your Pokemon?</h1>
        <div class="card shadow-sm mx-auto" style="max-width: 400px;">
            <div class="card-body">
                <p class="card-text text-muted">Enter your birthday to find your Pokemon!</p>
                <form action="/displayPokemon" method="POST">
                    <div class="mb-3">
                        <input type="date" name="birthday" class="form-control">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Get My Pokemon</button>
                </form>
            </div>
        </div>
    </div>

    <%- include("partials/footer.ejs") %>

</body>

</html>